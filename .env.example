# Copy to .env (git-ignored) and fill in. Used only by the helper scripts in ops/ and tests/.
# Nothing here is needed on the server itself.

# SSH access to the LoGaRT host (ops/*.sh run read-only checks or the indexer over SSH)
LOGART_SSH_HOST=ubuntu@your-logart-host.example.org
LOGART_SSH_KEY=/path/to/private/key
LOGART_SSH_PORT=22

# lg-api account used for smoke / comparison tests (any account that may search; no admin rights needed)
LG_USER=
LG_PASS=

# lg-api base URL as seen FROM THE SERVER (tests/prod_api_check.sh runs there)
LG_BASE=http://localhost:5633/lg-api
